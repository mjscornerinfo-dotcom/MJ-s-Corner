# MongoDB Atlas Connection URI
# Replace <db_password> with your actual MongoDB user password
MONGODB_URI=mongodb+srv://mjscornerinfo_db_user:<db_password>@mjscorner.o55ympi.mongodb.net/?retryWrites=true&w=majority

# Port for web service (default: 3000)
PORT=3000

# Cloudinary Configuration for Food Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Phone.Email OTP Authentication (https://www.phone.email/)
# Obtain your Client ID and API Key from https://admin.phone.email/
PHONE_EMAIL_CLIENT_ID=your_phone_email_client_id
PHONE_EMAIL_API_KEY=your_phone_email_api_key

# Razorpay Standard Web Checkout Integration
# Obtain Key ID and Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Mapbox Directions & Geocoding API for Automated Driving Distance & Delivery Fee
# Obtain from https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token

# Admin Access: Assigned directly in MongoDB Atlas (role: "admin")
# Optional env overrides (comma-separated):
# ADMIN_PHONES=
# ADMIN_EMAILS=admin@mjscorner.com
